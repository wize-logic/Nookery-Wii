/*
 * Town life (m_town_life.h): the activity act. A villager doing an activity
 * runs aNPC_ACT_SPECIAL with this act_proc: it turns to face the activity's
 * angle, then plays its animation (with its prop and sub-animation) until the
 * time is up. Any other act taking over (talk, greeting, umbrella, going home)
 * ends it through aNPC_tl_stop in aNPC_chk_request_act.
 */

enum {
    aNPC_ACT_TL_STEP_TURN,
    aNPC_ACT_TL_STEP_DO,

    aNPC_ACT_TL_STEP_NUM
};

static mTL_villager_c* aNPC_tl_get(NPC_ACTOR* nactorx) {
    if (!aNPC_IS_NRM_NPC(nactorx)) {
        return NULL;
    }

    return mTL_GetVillager(mNL_GetAnimalIdx(nactorx->npc_info.animal));
}

/* (spreads villagers' periodic checks over different frames) */
static int idx_frame_offset(NPC_ACTOR* nactorx) {
    return (mNL_GetAnimalIdx(nactorx->npc_info.animal) + 1) * 13;
}

static int aNPC_tl_wandering(NPC_ACTOR* nactorx) {
    return nactorx->think.idx == aNPC_THINK_WANDER || nactorx->think.idx == aNPC_THINK_WALK_WANDER;
}

/* Puts the activity's prop away (deletes it) */
static void aNPC_tl_prop_off(NPC_ACTOR* nactorx, mTL_villager_c* v) {
    if (v->prop != NULL) {
        if (nactorx->right_hand.item_actor_p == v->prop) {
            nactorx->right_hand.item_actor_p = NULL;
        }

        Actor_delete((ACTOR*)v->prop);
        v->prop = NULL;
    }

    if (nactorx->draw.sub_anim_type == aNPC_SUB_ANIM_UTIWA) {
        nactorx->draw.sub_anim_type = aNPC_SUB_ANIM_NONE;
    }
}

/* Ends the activity: event 2 when its time was up, 3 when something else took over */
static void aNPC_tl_stop(NPC_ACTOR* nactorx, int event) {
    mTL_villager_c* v = aNPC_tl_get(nactorx);

    if (v == NULL || v->state != mTL_STATE_DOING) {
        return;
    }

    aNPC_tl_prop_off(nactorx, v);
    mTL_LeaveGroup(mNL_GetAnimalIdx(nactorx->npc_info.animal));
    if (event == 3 && nactorx->condition_info.talk_condition != aNPC_TALK_TYPE_NONE) {
        /* the player came to chat: they may say what they were doing */
        mTL_NoteTalk(mNL_GetAnimalIdx(nactorx->npc_info.animal));
    }
    mTL_NoteEvent(mNL_GetAnimalIdx(nactorx->npc_info.animal), v->activity, event);
    v->state = mTL_STATE_IDLE;
    v->cooldown = mTL_test_activity >= 0 ? 0 : mTL_COOLDOWN;
}

/* The NPC actor of a town villager (Save animals index), or NULL */
static NPC_ACTOR* aNPC_tl_find_actor_act(int idx) {
    Actor_list* list = &((GAME_PLAY*)gamePT)->actor_info.list[ACTOR_PART_NPC];
    ACTOR* actor = list->actor;
    int n;

    for (n = list->num_actors; n != 0 && actor != NULL; n--, actor = actor->next_actor) {
        NPC_ACTOR* other = (NPC_ACTOR*)actor;

        if (aNPC_IS_NRM_NPC(other) && mNL_GetAnimalIdx(other->npc_info.animal) == idx) {
            return other;
        }
    }

    return NULL;
}

/* In a group: the talking member speaks, the others listen and sometimes react */
static void aNPC_tl_chat(NPC_ACTOR* nactorx, mTL_villager_c* v, int idx) {
    static const u8 talk_anim[] = { aNPC_ANIM_SMILE1, aNPC_ANIM_HAPPY1, aNPC_ANIM_HIRAMEKI1, aNPC_ANIM_KIDUKU1 };
    static const u8 react_anim[] = { aNPC_ANIM_CLAP1, aNPC_ANIM_HAPPY1, aNPC_ANIM_SMILE1 };
    mTL_group_c* g = &mTL_groups[v->group];
    int speaker = mTL_GroupTurn(v->group);

    if (g->turn_seq != v->turn_seen && speaker >= 0) {
        int anim = aNPC_ANIM_WAIT1;

        v->turn_seen = g->turn_seq;
        if (speaker == idx && mTL_Snowy() && RANDOM(2) == 0) {
            /* winter: a snowball at someone else in the group */
            int i;

            for (i = 0; i < g->count; i++) {
                int t = g->members[(g->turn + 1 + i) % g->count];

                if (t >= 0 && t != idx && (g->arrived & (1 << ((g->turn + 1 + i) % g->count)))) {
                    v->throw_at = t;
                    v->throw_frames = 28;
                    break;
                }
            }
            anim = aNPC_ANIM_TAMANAGE1;
            mTL_Bark(idx, mTL_BARK_SNOW, -1, -1);
        } else if (speaker == idx) {
            int a_idx;
            int b_idx;
            int topic = mTL_ChooseChatBark(idx, &a_idx, &b_idx);

            if (mTL_Night() && RANDOM(2) == 0) {
                topic = mTL_BARK_STARS;
            }
            anim = talk_anim[RANDOM(ARRAY_COUNT(talk_anim))];
            mTL_Bark(idx, topic, a_idx, b_idx);
        } else if (RANDOM(100) < 35) {
            anim = react_anim[RANDOM(ARRAY_COUNT(react_anim))];
            if (RANDOM(2) == 0) {
                mTL_Bark(idx, mTL_BARK_LAUGH, -1, -1);
            }
        }
        nactorx->draw.animation_id = -1;
        aNPC_Animation_init((ACTOR*)nactorx, anim, FALSE);
        v->repeats++;
    } else if (nactorx->draw.main_animation_state == cKF_STATE_STOPPED) {
        /* (a reaction done: back to listening) */
        aNPC_Animation_init((ACTOR*)nactorx, aNPC_ANIM_WAIT1, FALSE);
    }

    if (v->throw_frames > 0 && --v->throw_frames == 0 && v->throw_at >= 0) {
        /* the snowball lands: a puff of snow, and they laugh it off */
        NPC_ACTOR* target = aNPC_tl_find_actor_act(v->throw_at);

        if (target != NULL && eEC_CLIP != NULL) {
            xyz_t pos = target->actor_class.world.position;

            pos.y += 30.0f;
            eEC_CLIP->effect_make_proc(eEC_EFFECT_YUKIHANE, pos, 1, target->actor_class.shape_info.rotation.y,
                                       gamePT, target->actor_class.npc_id, 0, 0);
            mTL_Bark(v->throw_at, mTL_BARK_LAUGH, -1, -1);
            mTL_stats.snowballs++;
        }
        v->throw_at = -1;
    }
}

static void aNPC_tl_start_anim(NPC_ACTOR* nactorx, const mTL_activity_c* a) {
    aNPC_setupAction(nactorx, aNPC_ACTION_TYPE_WAIT);
    nactorx->draw.sub_anim_type = a->sub_anim;
    aNPC_Animation_init((ACTOR*)nactorx, a->anim, FALSE);
}

static void aNPC_act_town_life_main_proc(NPC_ACTOR* nactorx, GAME_PLAY* play) {
    mTL_villager_c* v = aNPC_tl_get(nactorx);
    const mTL_activity_c* a;

    if (v == NULL || v->state != mTL_STATE_DOING) {
        nactorx->action.step = aNPC_ACTION_END_STEP;
        return;
    }

    a = mTL_GetActivity(v->activity);
    switch (nactorx->action.step) {
        case aNPC_ACT_TL_STEP_TURN:
            nactorx->movement.mv_angl = v->angle;
            if (nactorx->actor_class.shape_info.rotation.y == v->angle) {
                nactorx->action.step = aNPC_ACT_TL_STEP_DO;
                if (a->prop != mTL_PROP_NONE && v->prop == NULL && nactorx->right_hand.item_actor_p == NULL &&
                    nactorx->right_hand.item_type == aNPC_ITEM_TYPE_NONE && CLIP(tools_clip) != NULL) {
                    ACTOR* prop = CLIP(tools_clip)->aTOL_birth_proc(a->prop, aTOL_ACTION_S_TAKEOUT,
                                                                    (ACTOR*)nactorx, (GAME*)play, -1, NULL);

                    if (prop != NULL) {
                        v->prop = prop;
                        nactorx->right_hand.item_actor_p = prop;
                    }
                }
                aNPC_tl_start_anim(nactorx, a);
            }
            break;
        case aNPC_ACT_TL_STEP_DO:
            nactorx->movement.mv_angl = v->angle;
            if (v->activity == mTL_ACT_CHAT) {
                if (v->group < 0 || !mTL_groups[v->group].active || !aNPC_tl_wandering(nactorx)) {
                    aNPC_tl_stop(nactorx, 2);
                    aNPC_setupAction(nactorx, aNPC_ACTION_TYPE_WAIT);
                    nactorx->action.step = aNPC_ACTION_END_STEP;
                } else {
                    aNPC_tl_chat(nactorx, v, mNL_GetAnimalIdx(nactorx->npc_info.animal));
                }
                break;
            }
            if ((play->game.frame_counter % 120) == (idx_frame_offset(nactorx) % 120) && RANDOM(3) == 0) {
                /* now and then, a word about it to anyone nearby */
                mTL_Bark(mNL_GetAnimalIdx(nactorx->npc_info.animal), mTL_ActivityBark(v->activity), -1, -1);
            }
            if (a->effect == mTL_EFFECT_SPLASH && (play->game.frame_counter % 20) == 0 && eEC_CLIP != NULL) {
                /* splashing in the puddles */
                eEC_CLIP->effect_make_proc(eEC_EFFECT_MIZUTAMA, nactorx->actor_class.world.position, 1,
                                           nactorx->actor_class.shape_info.rotation.y, (GAME*)play,
                                           nactorx->actor_class.npc_id, 0, 3);
            }
            if (a->effect == mTL_EFFECT_STARS && nactorx->draw.main_animation_state == cKF_STATE_STOPPED) {
                /* a slow turn, looking up at the sky */
                v->angle += 0x0C00;
            }
            if (nactorx->draw.main_animation_state == cKF_STATE_STOPPED) {
                /* a one-shot animation: again, from its start */
                nactorx->draw.animation_id = -1;
                aNPC_Animation_init((ACTOR*)nactorx, a->anim, FALSE);
                v->repeats++;
                v->oneshot = TRUE;
            } else if (nactorx->draw.main_animation_state == cKF_STATE_CONTINUE) {
                v->repeats++;
            }

            if (mTL_SecondsDoing(v) >= v->seconds || !aNPC_tl_wandering(nactorx)) {
                if (mTL_SecondsDoing(v) >= v->seconds && a->effect != mTL_EFFECT_NONE) {
                    /* done: the flower planted, the snowman built */
                    xyz_t spot;

                    spot.x = v->spot_x;
                    spot.y = nactorx->actor_class.world.position.y;
                    spot.z = v->spot_z;
                    mTL_DoEffect(mNL_GetAnimalIdx(nactorx->npc_info.animal), v->activity, &spot, v->angle, TRUE);
                }
                aNPC_tl_stop(nactorx, 2);
                aNPC_setupAction(nactorx, aNPC_ACTION_TYPE_WAIT);
                nactorx->action.step = aNPC_ACTION_END_STEP;
            }
            break;
    }
}

static void aNPC_act_town_life_init_proc(NPC_ACTOR* nactorx, GAME_PLAY* play) {
    mTL_villager_c* v = aNPC_tl_get(nactorx);

    if (v == NULL || v->state != mTL_STATE_DOING) {
        nactorx->action.step = aNPC_ACTION_END_STEP;
        return;
    }

    nactorx->action.step = aNPC_ACT_TL_STEP_TURN;
    nactorx->movement.mv_angl = v->angle;
    aNPC_setupAction(nactorx, aNPC_ACTION_TYPE_TURN);
}

static void aNPC_town_life_act_proc(NPC_ACTOR* nactorx, GAME_PLAY* play, int type) {
    static aNPC_SUB_PROC act_proc[] = {
        &aNPC_act_town_life_init_proc,
        (aNPC_SUB_PROC)&none_proc1,
        &aNPC_act_town_life_main_proc,
    };

    (*act_proc[type])(nactorx, play);
}

/* Walking to or standing in a group */
static int aNPC_tl_in_group(NPC_ACTOR* nactorx) {
    mTL_villager_c* v = aNPC_tl_get(nactorx);

    return v != NULL && v->state != mTL_STATE_IDLE && v->activity == mTL_ACT_CHAT && v->group >= 0 &&
           mTL_groups[v->group].active;
}

/* The hand is wanted for something else (an umbrella) */
static void aNPC_tl_hand_needed(NPC_ACTOR* nactorx) {
    mTL_villager_c* v = aNPC_tl_get(nactorx);

    if (v != NULL && v->state == mTL_STATE_DOING) {
        mTL_stats.last_interrupt_act = aNPC_ACT_UMB_OPEN;
        aNPC_tl_stop(nactorx, 3);
    }
}

/* Another act is taking over from an activity */
static void aNPC_tl_chk_interrupt(NPC_ACTOR* nactorx, u8 prev_idx, u8 next_idx) {
    if (prev_idx == aNPC_ACT_SPECIAL && next_idx != aNPC_ACT_SPECIAL &&
        nactorx->action.act_proc == &aNPC_town_life_act_proc) {
        mTL_stats.last_interrupt_act = next_idx;
        aNPC_tl_stop(nactorx, 3);
    }
}
