/*
 * Town life (m_town_life.h): wandering villagers sometimes pick an activity,
 * walk to a spot that suits it, and do it (ac_npc_act_town_life.c_inc).
 */

#define aNPC_TL_ARRIVE_DIST 14.0f /* close enough to the spot */
#define aNPC_TL_SPOT_TRIES 32      /* tiles tried when looking for a spot */
#define aNPC_TL_WALK_TRIES 3       /* walks toward the spot before giving up */
#define aNPC_TL_CHOOSE_TRIES 3     /* activities considered before giving up for now */

/* A free tile in the villager's area that suits place */
static int aNPC_tl_find_spot(NPC_ACTOR* nactorx, int idx, int place, xyz_t* spot) {
    int bx = nactorx->actor_class.block_x;
    int bz = nactorx->actor_class.block_z;
    int around_home = place == mTL_PLACE_FLOWERS || place == mTL_PLACE_PLANT || place == mTL_PLACE_FRUIT;
    int tries = around_home ? 11 * 11 : aNPC_TL_SPOT_TRIES;
    int start = RANDOM(11 * 11);
    xyz_t home;
    int i;

    if (around_home && !mTL_GetHomePos(idx, &home)) {
        return FALSE;
    }

    for (i = 0; i < tries; i++) {
        xyz_t pos;
        mActor_name_t* fg_p;

        if (around_home) {
            /* every tile within five of the house, from a random one on */
            int k = (start + i) % (11 * 11);

            pos.x = home.x + (k % 11 - 5) * mFI_UT_WORLDSIZE_X_F;
            pos.y = home.y;
            pos.z = home.z + (k / 11 - 5) * mFI_UT_WORLDSIZE_Z_F;
        } else {
            /* not the acre's edge tiles */
            mFI_BkandUtNum2CenterWpos(&pos, bx, bz, 1 + RANDOM(UT_X_NUM - 2), 1 + RANDOM(UT_Z_NUM - 2));
        }
        fg_p = mFI_GetUnitFG(pos);
        if (fg_p == NULL || (*fg_p != EMPTY_NO && !ITEM_IS_ITEM1(*fg_p))) {
            continue;
        }

        if (mCoBG_Wpos2CheckNpc(pos) != TRUE ||
            aNPC_moveRangeCheck2(nactorx, NULL, pos, nactorx->movement.range_type) != TRUE ||
            mTL_SpotTaken(idx, &pos) || !mTL_CheckPlace(place, idx, &pos)) {
            continue;
        }

        *spot = pos;
        return TRUE;
    }

    return FALSE;
}

/* The activity starts where the villager stands */
static void aNPC_tl_begin(NPC_ACTOR* nactorx, mTL_villager_c* v, int idx, u8* act_idx, u8* act_type) {
    v->state = mTL_STATE_DOING;
    v->start_sec = Common_Get(time.now_sec);
    v->repeats = 0;
    v->oneshot = FALSE;
    v->prop = NULL;
    nactorx->action.act_proc = &aNPC_town_life_act_proc;
    if (nactorx->action.idx == aNPC_ACT_SPECIAL) {
        /* (one activity right after another: aNPC_chk_request_act only starts an act that differs from the last) */
        nactorx->action.idx = aNPC_ACT_NONE;
    }
    *act_idx = aNPC_ACT_SPECIAL;
    *act_type = aNPC_ACT_TYPE_DEFAULT;
    mTL_NoteEvent(idx, v->activity, 1);
    if (mTL_GetActivity(v->activity)->effect == mTL_EFFECT_PICK) {
        xyz_t spot;

        spot.x = v->spot_x;
        spot.y = nactorx->actor_class.world.position.y;
        spot.z = v->spot_z;
        if (!mTL_DoEffect(idx, v->activity, &spot, v->angle, FALSE)) {
            /* (someone got the fruit first) */
            v->seconds = 0;
        }
    }
}

static void aNPC_tl_walk_to_spot(NPC_ACTOR* nactorx, mTL_villager_c* v, u8* act_idx, u8* act_type, u16* arg_data) {
    arg_data[2] = v->spot_x;
    arg_data[3] = v->spot_z;
    *act_idx = aNPC_ACT_WALK;
    if (aNPC_think_wander_check_ones_way(nactorx, arg_data) == TRUE) {
        *act_idx = aNPC_ACT_TURN;
    }
    *act_type = aNPC_ACT_TYPE_TO_POINT;
}

/* The NPC actor of a town villager (Save animals index), or NULL */
static NPC_ACTOR* aNPC_tl_find_actor(int idx) {
    Actor_list* list = &((GAME_PLAY*)gamePT)->actor_info.list[ACTOR_PART_NPC];
    ACTOR* actor = list->actor;
    int n;

    for (n = list->num_actors; n != 0 && actor != NULL; n--, actor = actor->next_actor) {
        NPC_ACTOR* other = (NPC_ACTOR*)actor;

        if (aNPC_IS_NRM_NPC(other) && mNL_GetAnimalIdx(other->npc_info.animal) == idx) {
            return other;
        }
    }

    return NULL;
}

/* A villager free to be called over: wandering, not busy, not talking, not hidden */
static int aNPC_tl_free(NPC_ACTOR* nactorx, int idx) {
    mTL_villager_c* v = mTL_GetVillager(idx);

    return v != NULL && v->state == mTL_STATE_IDLE && aNPC_tl_wandering(nactorx) &&
           !nactorx->condition_info.hide_flg && nactorx->condition_info.talk_condition == aNPC_TALK_TYPE_NONE &&
           nactorx->palActor == NULL;
}

/* Ends a free villager's current wait or walk, so they act on a new plan now */
static void aNPC_tl_call_over(NPC_ACTOR* nactorx) {
    switch (nactorx->action.idx) {
        case aNPC_ACT_WAIT:
        case aNPC_ACT_WALK:
        case aNPC_ACT_RUN:
        case aNPC_ACT_TURN:
            nactorx->action.step = aNPC_ACTION_END_STEP;
            break;
    }
}

/* The leader calls friends in the same acre over to a spot; TRUE when a group formed (the leader's walk is set) */
static int aNPC_tl_try_group(NPC_ACTOR* leader, int idx, u8* act_idx, u8* act_type, u16* arg_data) {
    /* (room for a circle: not beside trees or water) */
    static const u8 places[] = { mTL_PLACE_PLAZA, mTL_PLACE_OPEN };
    Animal_c* animals = Save_Get(animals);
    Actor_list* list = &((GAME_PLAY*)gamePT)->actor_info.list[ACTOR_PART_NPC];
    ACTOR* actor = list->actor;
    NPC_ACTOR* member[mTL_GROUP_MAX];
    int ids[mTL_GROUP_MAX];
    xyz_t pos[mTL_GROUP_MAX];
    xyz_t center;
    mActor_name_t* fg_p;
    mTL_group_c* g;
    int count = 1;
    int placed;
    int group;
    s16 base;
    f32 radius;
    int i;
    int j;
    int n;

    member[0] = leader;
    ids[0] = idx;
    for (n = list->num_actors; n != 0 && actor != NULL && count < mTL_GROUP_MAX; n--, actor = actor->next_actor) {
        NPC_ACTOR* other = (NPC_ACTOR*)actor;
        int o;

        if (other == leader || !aNPC_IS_NRM_NPC(other) || actor->block_x != leader->actor_class.block_x ||
            actor->block_z != leader->actor_class.block_z) {
            continue;
        }

        o = mNL_GetAnimalIdx(other->npc_info.animal);
        if (o < 0 || !aNPC_tl_free(other, o) || animals[idx].animal_relations[o] < mNL_RELATION_FRIEND) {
            continue;
        }

        /* nobody joins a group with someone they don't get along with */
        for (j = 0; j < count; j++) {
            if (animals[ids[j]].animal_relations[o] <= mNL_RELATION_RIVAL ||
                animals[o].animal_relations[ids[j]] <= mNL_RELATION_RIVAL) {
                break;
            }
        }
        if (j < count) {
            continue;
        }

        member[count] = other;
        ids[count] = o;
        count++;
    }

    if (count < 2) {
        return FALSE;
    }

    for (i = 0; i < (int)ARRAY_COUNT(places); i++) {
        if (aNPC_tl_find_spot(leader, idx, places[i], &center)) {
            break;
        }
    }
    if (i == (int)ARRAY_COUNT(places)) {
        return FALSE;
    }

    /* places around the center, facing it */
    radius = 30.0f + 5.0f * count;
    base = (s16)RANDOM(0x10000);
    placed = 0;
    for (i = 0; i < count; i++) {
        for (j = 0; j < 4; j++) {
            s16 angle = (s16)(base + (0x10000 / count) * i + (j & 1 ? 1 : -1) * j * 0x0800);

            pos[i].x = center.x + sin_s(angle) * radius;
            pos[i].y = center.y;
            pos[i].z = center.z + cos_s(angle) * radius;
            fg_p = mFI_GetUnitFG(pos[i]);
            if (fg_p != NULL && (*fg_p == EMPTY_NO || ITEM_IS_ITEM1(*fg_p)) && mCoBG_Wpos2CheckNpc(pos[i]) == TRUE &&
                aNPC_moveRangeCheck2(member[i], NULL, pos[i], member[i]->movement.range_type) == TRUE) {
                break;
            }
        }
        if (j == 4) {
            if (i == 0) {
                return FALSE;
            }
            ids[i] = -1;
        } else {
            placed++;
        }
    }
    if (placed < 2) {
        return FALSE;
    }

    group = mTL_NewGroup();
    if (group < 0) {
        return FALSE;
    }

    g = &mTL_groups[group];
    g->active = TRUE;
    g->count = 0;
    g->center_x = (s16)center.x;
    g->center_z = (s16)center.z;
    g->start_sec = Common_Get(time.now_sec);
    g->seconds = 60 + RANDOM(121);
    g->turn_sec = g->start_sec;
    for (i = 0; i < count; i++) {
        mTL_villager_c* v;

        if (ids[i] < 0) {
            continue;
        }

        v = mTL_GetVillager(ids[i]);
        g->members[g->count++] = ids[i];
        v->state = mTL_STATE_GOING;
        v->activity = mTL_ACT_CHAT;
        v->spot_x = (s16)pos[i].x;
        v->spot_z = (s16)pos[i].z;
        v->angle = search_position_angleY(&pos[i], &center);
        v->seconds = g->seconds;
        v->tries = aNPC_TL_WALK_TRIES;
        v->last_dist = 0;
        v->group = group;
        v->turn_seen = 0xFF;
        if (member[i] != leader) {
            aNPC_tl_call_over(member[i]);
        }
    }

    mTL_stats.groups_formed++;
    mTL_stats.group_members += g->count;
    aNPC_tl_walk_to_spot(leader, mTL_GetVillager(idx), act_idx, act_type, arg_data);
    return TRUE;
}

/* A group member reaches its place: it meets the members already there */
static void aNPC_tl_arrive_group(mTL_villager_c* v, int idx) {
    mTL_group_c* g = &mTL_groups[v->group];
    int i;

    for (i = 0; i < g->count; i++) {
        if (g->members[i] == idx) {
            g->arrived |= 1 << i;
            g->met |= 1 << i;
            break;
        }
    }

    for (i = 0; i < g->count; i++) {
        if (g->members[i] >= 0 && g->members[i] != idx && (g->arrived & (1 << i))) {
            mTL_GroupMeet(idx, g->members[i]);
        }
    }
}

/* Evenings: a villager heading home is walked there by a free friend in the same acre */
static void aNPC_tl_going_home(NPC_ACTOR* nactorx) {
    Animal_c* animals = Save_Get(animals);
    Actor_list* list = &((GAME_PLAY*)gamePT)->actor_info.list[ACTOR_PART_NPC];
    ACTOR* actor = list->actor;
    NPC_ACTOR* best = NULL;
    f32 best_dist = 400.0f;
    int hour = Common_Get(time.rtc_time).hour;
    int idx = mNL_GetAnimalIdx(nactorx->npc_info.animal);
    int n;

    if (!mTL_IsEnabled() || idx < 0 || !(mTL_test_group_any_hour || (hour >= 17 && hour < 24))) {
        return;
    }

    for (n = list->num_actors; n != 0 && actor != NULL; n--, actor = actor->next_actor) {
        NPC_ACTOR* other = (NPC_ACTOR*)actor;
        int o;
        f32 dist;

        if (other == nactorx || !aNPC_IS_NRM_NPC(other) || actor->block_x != nactorx->actor_class.block_x ||
            actor->block_z != nactorx->actor_class.block_z) {
            continue;
        }

        o = mNL_GetAnimalIdx(other->npc_info.animal);
        if (o < 0 || !aNPC_tl_free(other, o) || animals[o].animal_relations[idx] < mNL_RELATION_FRIEND ||
            animals[idx].animal_relations[o] < mNL_RELATION_FRIEND) {
            continue;
        }

        dist = search_position_distanceXZ(&actor->world.position, &nactorx->actor_class.world.position);
        if (dist < best_dist) {
            best_dist = dist;
            best = other;
        }
    }

    if (best != NULL) {
        int o = mNL_GetAnimalIdx(best->npc_info.animal);
        mTL_villager_c* v = mTL_GetVillager(o);

        v->state = mTL_STATE_ESCORT;
        v->activity = mTL_ACT_ESCORT;
        v->escort = idx;
        v->group = -1;
        v->start_sec = Common_Get(time.now_sec);
        v->seconds = 30 + RANDOM(16);
        mTL_NoteEvent(o, mTL_ACT_ESCORT, 1);
        mTL_stats.escorts++;
        aNPC_tl_call_over(best);
    }
}

/* Walking a friend home: a step beside them, until they're in or the time is up */
static int aNPC_tl_escort(NPC_ACTOR* nactorx, mTL_villager_c* v, int idx, u8* act_idx, u8* act_type, u16* arg_data) {
    NPC_ACTOR* friend_nactorx = aNPC_tl_find_actor(v->escort);

    if (friend_nactorx == NULL || friend_nactorx->condition_info.hide_flg || mTL_SecondsDoing(v) >= v->seconds ||
        search_position_distanceXZ(&nactorx->actor_class.world.position,
                                   &friend_nactorx->actor_class.world.position) > 400.0f ||
        !aNPC_life_to_friend(nactorx, friend_nactorx, arg_data)) {
        v->state = mTL_STATE_IDLE;
        v->cooldown = mTL_COOLDOWN;
        mTL_NoteEvent(idx, mTL_ACT_ESCORT, 2);
        return FALSE;
    }

    *act_idx = aNPC_ACT_WALK;
    if (aNPC_think_wander_check_ones_way(nactorx, arg_data) == TRUE) {
        *act_idx = aNPC_ACT_TURN;
    }
    *act_type = aNPC_ACT_TYPE_TO_POINT;
    return TRUE;
}

static int aNPC_town_life_decide(NPC_ACTOR* nactorx, u8* act_idx, u8* act_type, u16* arg_data) {
    mTL_villager_c* v;
    int idx;

    if (!mTL_IsEnabled() || !aNPC_IS_NRM_NPC(nactorx) || !aNPC_tl_wandering(nactorx)) {
        return FALSE;
    }

    idx = mNL_GetAnimalIdx(nactorx->npc_info.animal);
    v = mTL_GetVillager(idx);
    if (v == NULL || (mTL_test_villager >= 0 && idx != mTL_test_villager)) {
        return FALSE;
    }

    switch (v->state) {
        case mTL_STATE_DOING:
            /* (only here when the act ended without aNPC_tl_stop, which shouldn't happen) */
            v->state = mTL_STATE_IDLE;
            return FALSE;

        case mTL_STATE_ESCORT:
            return aNPC_tl_escort(nactorx, v, idx, act_idx, act_type, arg_data);

        case mTL_STATE_GOING: {
            xyz_t spot;
            f32 dist;

            if (v->activity == mTL_ACT_CHAT && (v->group < 0 || !mTL_groups[v->group].active)) {
                /* (the group broke up before this member got there) */
                v->state = mTL_STATE_IDLE;
                v->group = -1;
                return FALSE;
            }

            spot.x = v->spot_x;
            spot.y = nactorx->actor_class.world.position.y;
            spot.z = v->spot_z;
            dist = search_position_distanceXZ(&nactorx->actor_class.world.position, &spot);
            if (dist < aNPC_TL_ARRIVE_DIST ||
                /* stuck close by (another villager, a tree in the way): close enough */
                (dist < (v->activity == mTL_ACT_CHAT ? 45.0f : 24.0f) && v->last_dist > 0 &&
                 dist > v->last_dist - 10.0f)) {
                aNPC_tl_begin(nactorx, v, idx, act_idx, act_type);
                if (v->activity == mTL_ACT_CHAT) {
                    xyz_t center;

                    center.x = mTL_groups[v->group].center_x;
                    center.y = spot.y;
                    center.z = mTL_groups[v->group].center_z;
                    v->angle = search_position_angleY(&nactorx->actor_class.world.position, &center);
                    aNPC_tl_arrive_group(v, idx);
                }
                return TRUE;
            }

            if (v->last_dist == 0 || dist < v->last_dist - 20.0f) {
                /* getting there (walks stop for rests along the way) */
                v->last_dist = (s16)dist;
                aNPC_tl_walk_to_spot(nactorx, v, act_idx, act_type, arg_data);
                return TRUE;
            }
            if (v->tries > 0) {
                v->tries--;
                v->last_dist = (s16)dist;
                aNPC_tl_walk_to_spot(nactorx, v, act_idx, act_type, arg_data);
                return TRUE;
            }

            mTL_LeaveGroup(idx);
            v->state = mTL_STATE_IDLE;
            v->cooldown = 2;
            mTL_stats.no_spot++;
            return FALSE;
        }

        default: {
            const mTL_activity_c* a;
            xyz_t spot;
            int place = mTL_PLACE_ANYWHERE;
            int act;
            int tries;

            if (nactorx->actor_class.player_distance_xz < 80.0f && RANDOM(100) < 8) {
                /* the player passing by */
                mTL_Bark(idx, mTL_BARK_GREET, -1, -1);
            }

            if (v->cooldown > 0) {
                v->cooldown--;
                return FALSE;
            }

            if (mTL_test_activity < 0 && mTL_GatherHour() && RANDOM(100) < mTL_group_chance &&
                aNPC_tl_try_group(nactorx, idx, act_idx, act_type, arg_data)) {
                return TRUE;
            }

            if (RANDOM(100) >= mTL_start_chance) {
                return FALSE;
            }

            /* a few tries: the first choice may need a place this acre doesn't have (a river, a tree) */
            for (tries = 0; tries < aNPC_TL_CHOOSE_TRIES; tries++) {
                act = mTL_ChooseActivity(mNpc_GetNpcLooks((ACTOR*)nactorx), idx);
                if (act < 0) {
                    return FALSE;
                }

                a = mTL_GetActivity(act);
                if ((a->prop != mTL_PROP_NONE || a->sub_anim != aNPC_SUB_ANIM_NONE) &&
                    (nactorx->right_hand.item_type != aNPC_ITEM_TYPE_NONE ||
                     nactorx->right_hand.item_actor_p != NULL)) {
                    /* (the hand is full: an umbrella) */
                    continue;
                }

                place = mTL_test_activity >= 0 && !mTL_test_keep_place ? mTL_PLACE_ANYWHERE : a->place;
                if (place == mTL_PLACE_ANYWHERE) {
                    spot = nactorx->actor_class.world.position;
                    break;
                }
                if (aNPC_tl_find_spot(nactorx, idx, place, &spot)) {
                    break;
                }
            }

            if (tries == aNPC_TL_CHOOSE_TRIES) {
                v->cooldown = 2;
                mTL_stats.no_spot++;
                return FALSE;
            }

            v->activity = act;
            v->spot_x = (s16)spot.x;
            v->spot_z = (s16)spot.z;
            v->angle = mTL_PlaceAngle(place, &spot, nactorx->actor_class.shape_info.rotation.y);
            v->seconds = mTL_test_seconds > 0 ? mTL_test_seconds
                                              : a->min_sec + RANDOM(a->max_sec - a->min_sec + 1);
            v->tries = aNPC_TL_WALK_TRIES;
            v->last_dist = 0;
            v->group = -1;
            v->state = mTL_STATE_GOING;

            if (place == mTL_PLACE_ANYWHERE) {
                aNPC_tl_begin(nactorx, v, idx, act_idx, act_type);
            } else {
                aNPC_tl_walk_to_spot(nactorx, v, act_idx, act_type, arg_data);
            }
            return TRUE;
        }
    }
}
