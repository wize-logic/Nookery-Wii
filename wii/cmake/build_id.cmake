# Writes OUT (nk_build_id.h): the commit the build comes from, and whether files differed from it, so a log and a
# crash report say which build they come from (and so which nookery.elf turns their addresses into names).
# Run at every build (Wii.cmake's nk_build_id target); the file is only rewritten when the id changes.
execute_process(COMMAND git rev-parse --short=10 HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _r ERROR_QUIET)
if(NOT _r EQUAL 0 OR _commit STREQUAL "")
    set(_commit "unknown")
else()
    execute_process(COMMAND git diff --quiet HEAD -- . WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE _dirty ERROR_QUIET)
    if(NOT _dirty EQUAL 0)
        string(APPEND _commit "-modified")
    endif()
    execute_process(COMMAND git log -1 --format=%cd --date=short WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE _date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
set(_text "/* Generated by wii/cmake/build_id.cmake. Do not edit. */\n#define NK_BUILD_ID \"${_commit}\"\n#define NK_BUILD_DATE \"${_date}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
